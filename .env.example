# Firebase Web settings. Values beginning with VITE_ are public browser configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-only settings. Use a database role with SELECT on the monitoring tables.
FIREBASE_PROJECT_ID=
MONITORING_DATABASE_URL=
MONITORING_ADMIN_EMAILS=
MONITORING_NODES='[{"id":"node-1","label":"VPS A","description":"Serviço monitorado"}]'
HOST=127.0.0.1
PORT=3000
