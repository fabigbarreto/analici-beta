# Use a origem exata que aparece no navegador, sem barra no final.
BETA_PUBLIC_ORIGIN=http://127.0.0.1:3000
BETA_ADMIN_USERNAME=
BETA_ADMIN_PASSWORD_HASH_FILE=
# Habilite somente atrás de um único proxy com acesso privado ao servidor.
BETA_TRUST_PROXY=0

# Somente no servidor. O arquivo contém a URL PostgreSQL do usuário de leitura.
MONITORING_DATABASE_URL_FILE=
MONITORING_NODES='[{"id":"node-1","label":"VPS A","description":"Serviço monitorado"}]'
# Conexão de leitura com o Atlas Web. Guarde o token em um arquivo privado.
ATLAS_EXECUTIONS_ORIGIN=
ATLAS_EXECUTIONS_TOKEN_FILE=
HOST=127.0.0.1
PORT=3000
