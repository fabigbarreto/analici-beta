{
  "name": "analici-beta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "vite --mode demo --host 127.0.0.1",
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build --outDir dist/client && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "4.22.3",
    "lucide-react": "0.546.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "6.4.6"
  }
}
